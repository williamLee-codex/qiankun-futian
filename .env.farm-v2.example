# API Functions only. Inject real values securely; never commit them.
NODE_ENV=production
DATABASE_URL=
FARM_DB_POOL_MAX=1
# Required: session or direct. Transaction-mode pooling is incompatible.
FARM_DB_CONNECTION_MODE=session
# Optional trusted CA PEM file when required by the database provider.
FARM_DB_CA_FILE=
PLATFORM_BASE_URL=
REPLIT_APP_SHARED_SECRET=
# Keep both disabled until approved migration + runtime verification.
FARM_V2_ENTRY_ENABLED=0
FARM_V2_ATOMIC_POT_ENABLED=0
# Main website origin, HTTPS only, no path. No credentialed browser cookies.
FARM_V2_ALLOWED_ORIGIN=

# Existing frontend export only; not a second frontend deployment.
BASE_PATH=/farm-v2/
VITE_FARM_API_BASE_URL=/api/farm-backend/
PORT=4173
