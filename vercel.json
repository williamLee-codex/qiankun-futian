{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm --filter @workspace/api-server run build && mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{artifacts/api-server/dist/**,certs/**}"
    },
    "api/isolation-check.mjs": {
      "maxDuration": 15,
      "includeFiles": "certs/**"
    },
    "api/preview-bridge-check.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/farm-preview-bridge-check",
      "destination": "/api/preview-bridge-check"
    },
    {
      "source": "/isolation-check",
      "destination": "/api/isolation-check"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "regions": [
    "sin1"
  ]
}
